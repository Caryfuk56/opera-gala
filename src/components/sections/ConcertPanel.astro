---
import { getI18n, getPath } from "../../i18n";
import CtaButton from "../ui/CtaButton.astro";

interface Props {
	id: string;
	title: string;
	subtitle?: string;
	date: {
		day: string;
		month: string;
		year: string;
	};
	ticketUrl?: string;
	lang: string;
	dateVariant?: "short" | "full";
}

const { id, title, subtitle, date, ticketUrl, lang, dateVariant = "full" } = Astro.props;
const { t } = getI18n(lang);
const href = getPath(lang, `concert/${id}`);
---

<article class="flex flex-col gap-4 rounded-lg border border-text-secondary/10 bg-bg-secondary/30 p-6 sm:flex-row sm:items-center sm:gap-8 hover:bg-bg-secondary/40 transition-colors">
	<div class="flex-shrink-0 text-center sm:w-28 border-r border-accent pr-6 mr-2">
		<span class="block font-heading text-4xl font-bold text-accent lg:text-5xl">
			{date.day}
		</span>
		<span class="block text-sm uppercase tracking-wider text-text-secondary mt-1">
			{date.month}
			{dateVariant === "full" && <span class="block text-sm font-bold text-accent mt-1">{date.year}</span>}
		</span>
	</div>

	<div class="flex-1 min-w-0">
		<h3 class="font-heading text-lg font-semibold text-text-primary lg:text-xl truncate">
			<a href={href} class="hover:text-accent transition-colors before:absolute before:inset-0 relative">
				{title}
			</a>
		</h3>
		{subtitle && (
			<p class="mt-1 text-sm text-text-secondary truncate">
				{subtitle}
			</p>
		)}
	</div>

	{ticketUrl && (
		<div class="flex-shrink-0 relative z-10">
			<CtaButton href={ticketUrl} variant="highlighted">
				{t.concerts.tickets}
			</CtaButton>
		</div>
	)}
</article>
