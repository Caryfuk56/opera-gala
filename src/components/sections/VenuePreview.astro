---
import { getI18n, getPath } from "../../i18n";
import venueImage from "../../assets/valtice_zamek_noc.png";

interface Props {
	lang: string;
}

const { lang } = Astro.props;
const { t } = getI18n(lang);
---

<section class="relative py-20 lg:py-28 overflow-hidden">
	<div class="venue-bg absolute inset-0 overflow-hidden bg-bg-secondary">
		<img
			src={venueImage.src}
			alt=""
			role="presentation"
			class="venue-bg-img absolute inset-0 w-full h-[120%] object-cover object-top"
			loading="lazy"
			decoding="async"
		/>
	</div>
	<div class="absolute inset-0 bg-gradient-to-b from-bg-primary/60 via-bg-primary/40 to-bg-primary/70"></div>

	<div class="container relative z-10">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="font-heading text-3xl font-bold text-text-primary sm:text-4xl lg:text-5xl">
				{t.venue.title}
			</h2>

			<p class="mt-6 font-body text-base leading-relaxed text-text-secondary lg:text-lg">
				{t.venue.text}
			</p>

			<a
				href={getPath(lang, "practical-info")}
				class="mt-8 inline-flex items-center gap-2 font-medium text-accent transition-colors hover:text-accent-deep"
			>
				<span>&rarr;</span>
				<span>{t.venue.cta}</span>
			</a>
		</div>
	</div>
</section>

<script>
	(function () {
		const win = window as Window & { __venueParallaxCleanup?: () => void };
		win.__venueParallaxCleanup?.();
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		// Parallax effect for venue background
		const venueBg = document.querySelector(".venue-bg") as HTMLElement | null;
		const venueBgImg = document.querySelector(".venue-bg-img") as HTMLImageElement | null;
		if (!venueBg) return;
		if (!venueBgImg) return;
		const venueBgEl = venueBg;
		const venueBgImgEl = venueBgImg;

		let lastScrollY = window.scrollY;
		let currentTransform = 0;
		let maxShift = 0;

		function measure() {
			const containerHeight = venueBgEl.clientHeight;
			const imageHeight = venueBgImgEl.clientHeight;
			maxShift = Math.max(0, imageHeight - containerHeight);
			currentTransform = Math.min(0, Math.max(-maxShift, currentTransform));
			venueBgImgEl.style.transform = `translateY(${currentTransform}px)`;
		}

		function updateParallax() {
			const scrollY = window.scrollY;
			const scrollDelta = scrollY - lastScrollY;

			// Keep the image's top aligned with the section on first render (transform = 0).
			// Then only allow moving the image UP (negative translate) so we never reveal empty space.
			currentTransform -= scrollDelta * 0.3;
			currentTransform = Math.min(0, Math.max(-maxShift, currentTransform));
			venueBgImgEl.style.transform = `translateY(${currentTransform}px)`;

			lastScrollY = scrollY;
		}

		let ticking = false;
		function requestTick() {
			if (!ticking) {
				ticking = true;
				window.requestAnimationFrame(() => {
					updateParallax();
					ticking = false;
				});
			}
		}

		if (venueBgImgEl.complete) {
			measure();
		} else {
			venueBgImgEl.addEventListener("load", measure, { once: true });
		}
		window.addEventListener("resize", measure, { passive: true });
		window.addEventListener("scroll", requestTick, { passive: true });
		win.__venueParallaxCleanup = () => {
			window.removeEventListener("resize", measure);
			window.removeEventListener("scroll", requestTick);
		};
	})();
</script>
