---
import { getI18n, getPath } from "../../i18n";
import CtaButton from "../ui/CtaButton.astro";
import ConcertPanel from "./ConcertPanel.astro";
import { fetchUpcomingEvents, parseEventDescription, getEventIsoDate, formatDate, type CalendarEvent } from "../../utils/googleCalendar";

interface Props {
	lang: string;
}

const { lang } = Astro.props;
const { t } = getI18n(lang);

const apiKey = import.meta.env.GOOGLE_CALENDAR_API;
const calendarId = import.meta.env.GOOGLE_CALENDAR_ID;

let events: CalendarEvent[] = [];
let loadError: string | null = null;

if (!apiKey || !calendarId) {
	loadError = t.concerts.error;
} else {
	try {
		events = await fetchUpcomingEvents({ calendarId, apiKey, maxResults: 3 });
	} catch (err) {
		loadError = t.concerts.error;
	}
}
---

<section class="bg-bg-primary py-20 lg:py-28">
	<div class="container">
		<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6">
			<h2 class="font-heading text-3xl font-bold text-text-primary sm:text-4xl lg:text-5xl">
				{t.concerts.title}
			</h2>
			<CtaButton href={getPath(lang, "concert")} variant="secondary">
				{t.hero.ctaSecondary}
			</CtaButton>
		</div>

		{loadError ? (
			<p class="mt-8 font-body text-base text-text-secondary">{loadError}</p>
		) : events.length === 0 ? (
			<p class="mt-8 font-body text-base text-text-secondary">{t.concerts.empty}</p>
		) : (
			<div class="mt-12 space-y-4">
				{events.map((event) => {
					const isoDate = getEventIsoDate(event);
					const dateObj = isoDate ? formatDate(isoDate, lang, "short") : { day: "", month: "", year: "" };
					const parsed = parseEventDescription(event.description);

					return (
						<ConcertPanel
							id={event.id}
							title={event.summary ?? ""}
							subtitle={parsed.subtitle}
							date={dateObj}
							ticketUrl={parsed.ticket}
							lang={lang}
							dateVariant="short"
						/>
					);
				})}
			</div>
		)}
	</div>
</section>
