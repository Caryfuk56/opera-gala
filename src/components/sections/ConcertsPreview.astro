---
import { getI18n, getPath } from "../../i18n";
import CtaButton from "../ui/CtaButton.astro";

interface Props {
	lang: string;
}

const { lang } = Astro.props;
const { t } = getI18n(lang);

const concerts = [
	{ day: "14", month: lang === "cs" ? "června" : "June", name: "Händel: Giulio Cesare", location: "Zámek Valtice – Mramorový sál" },
	{ day: "28", month: lang === "cs" ? "června" : "June", name: "Vivaldi: La Stravaganza", location: "Zámek Valtice – Zámecká kaple" },
	{ day: "12", month: lang === "cs" ? "července" : "July", name: "Bach: Braniborské koncerty", location: "Zámek Valtice – Mramorový sál" },
];
---

<section class="bg-bg-primary py-20 lg:py-28">
	<div class="container">
		<h2 class="font-heading text-3xl font-bold text-text-primary sm:text-4xl lg:text-5xl">
			{t.concerts.title}
		</h2>

		<div class="mt-12 space-y-6">
			{concerts.map((concert) => (
				<article class="flex flex-col gap-4 rounded-lg border border-text-secondary/10 bg-bg-secondary/30 p-6 sm:flex-row sm:items-center sm:gap-8">
					<div class="flex-shrink-0 text-center sm:w-24">
						<span class="block font-heading text-4xl font-bold text-accent lg:text-5xl">
							{concert.day}
						</span>
						<span class="block text-sm uppercase tracking-wider text-text-secondary">
							{concert.month}
						</span>
					</div>

					<div class="flex-1">
						<h3 class="font-heading text-lg font-semibold text-text-primary lg:text-xl">
							{concert.name}
						</h3>
						<p class="mt-1 text-sm text-text-secondary">
							{concert.location}
						</p>
					</div>

					<div class="flex-shrink-0">
						<CtaButton href={getPath(lang, "concert")} variant="wine">
							{t.concerts.tickets}
						</CtaButton>
					</div>
				</article>
			))}
		</div>
	</div>
</section>
