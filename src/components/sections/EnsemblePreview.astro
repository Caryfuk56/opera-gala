---
import { getI18n, getPath } from "../../i18n";
import ensembleImage from "../../assets/barokni_zkouska.png";

interface Props {
	lang: string;
}

const { lang } = Astro.props;
const { t } = getI18n(lang);
---

<section class="bg-bg-primary py-20 lg:py-28">
	<div class="container">
		<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
			<div>
				<h2 class="font-heading text-3xl font-bold text-text-primary sm:text-4xl lg:text-5xl">
					{t.ensemble.title}
				</h2>

				<p class="mt-6 font-body text-base leading-relaxed text-text-secondary lg:text-lg">
					{t.ensemble.text}
				</p>

				<a
					href={getPath(lang, "artists")}
					class="mt-8 inline-flex items-center gap-2 font-medium text-accent transition-colors hover:text-accent-deep"
				>
					<span>&rarr;</span>
					<span>{t.ensemble.cta}</span>
				</a>
			</div>

			<div class="order-first lg:order-last">
				<div class="aspect-[4/3] rounded-lg overflow-hidden">
					<img
						src={ensembleImage.src}
						alt=""
						role="presentation"
						class="h-full w-full object-cover"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
		</div>
	</div>
</section>
