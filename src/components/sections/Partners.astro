---
import { getI18n } from "../../i18n";
import { getPartners } from "../../utils/partners";

interface Props {
	lang: string;
}

const { lang } = Astro.props;
const { t } = getI18n(lang);
const partners = getPartners();
---

<section class="bg-bg-secondary/50 py-16 lg:py-20">
	<div class="container">
		<h2 class="text-center font-heading text-xl font-semibold text-text-secondary sm:text-2xl">
			{t.partners.title}
		</h2>

		<div class="mx-auto mt-10 flex max-w-4xl flex-wrap items-center justify-center gap-8 lg:gap-12">
			{
				partners.map((partner) => {
					const maxWidth =
						partner.dimensions.width === "auto" ? "" : ` max-width: ${partner.dimensions.width};`;
					const imageStyle = `height: ${partner.dimensions.height}; width: auto;${maxWidth}`;

					return (
						<a
							href={partner.url}
							target="_blank"
							rel="noopener noreferrer"
							title={partner.name}
							aria-label={partner.name}
							class="inline-flex items-center justify-center rounded-sm transition-opacity hover:opacity-85 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-bg-secondary"
						>
							<img
								src={partner.image.src}
								alt={partner.name}
								class="max-w-full object-contain"
								style={imageStyle}
								loading="lazy"
								decoding="async"
							/>
						</a>
					);
				})
			}
		</div>
	</div>
</section>
