---
import TicketIcon from "../icons/TicketIcon.astro";

interface Props {
	href: string;
	variant?: "primary" | "secondary" | "highlighted";
	class?: string;
}

const { href, variant = "primary", class: className = "" } = Astro.props;

const base =
	"inline-flex items-center justify-center rounded px-6 py-3 text-sm font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-bg-primary";

const variants: Record<string, string> = {
	primary: "bg-gradient-to-b from-accent to-accent-deep text-text-primary shadow-md uppercase tracking-wide hover:brightness-110",
	secondary: "border border-text-secondary/10 bg-bg-primary/40 text-text-primary backdrop-blur-md hover:bg-bg-primary/60",
	highlighted: "bg-text-primary text-accent-deep uppercase tracking-wide shadow-sm hover:bg-text-primary/95 hover:shadow-md",
};

const classes = [base, variants[variant], className].filter(Boolean).join(" ");
---

<a href={href} class={classes}>
	<slot />
	{variant === "highlighted" && <TicketIcon class="ml-2" size={18} />}
</a>
