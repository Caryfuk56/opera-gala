---
import { getI18n } from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/sections/Hero.astro";
import ConcertsPreview from "../../components/sections/ConcertsPreview.astro";
import ImportantMessages from "../../components/sections/ImportantMessages.astro";
import AboutProject from "../../components/sections/AboutProject.astro";
import EnsemblePreview from "../../components/sections/EnsemblePreview.astro";
import VenuePreview from "../../components/sections/VenuePreview.astro";
import GalleryPreview from "../../components/sections/GalleryPreview.astro";
import Partners from "../../components/sections/Partners.astro";
import { fetchUpcomingEvents } from "../../utils/googleCalendar";

const lang = Astro.params.lang ?? "cs";
const { t } = getI18n(lang);

const apiKey = import.meta.env.GOOGLE_CALENDAR_API;
const calendarId = import.meta.env.GOOGLE_CALENDAR_ID;
const showImportantMessages = true;

let nextConcertId: string | undefined;

if (apiKey && calendarId) {
	try {
		const events = await fetchUpcomingEvents({ calendarId, apiKey, maxResults: 1 });
		if (events.length > 0) {
			nextConcertId = events[0].id;
		}
	} catch (error) {
		console.error("Error fetching next concert:", error);
	}
}
---

<Layout
	lang={lang}
	title={`${t.hero.title} - Valtice`}
	description={t.seo.homeDescription}
>
	{showImportantMessages && (
		<ImportantMessages
			slot="top"
			lang={lang}
			concertUrl={nextConcertId ? `concert/${nextConcertId}` : undefined}
		/>
	)}
	<Hero lang={lang} nextConcertId={nextConcertId} />
	<ConcertsPreview lang={lang} />
	<AboutProject lang={lang} />
	<EnsemblePreview lang={lang} />
	<VenuePreview lang={lang} />
	<GalleryPreview lang={lang} />
	<Partners lang={lang} />
</Layout>
