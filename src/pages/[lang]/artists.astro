---
import { getI18n, getStaticLangPaths } from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import ArtistMedallion from "../../components/ui/ArtistMedallion.astro";
import artistsHeroImage from "../../assets/barokni_zkouska.png";
import robertHugoImage from "../../assets/robert-hugo_03.webp";
import ensembleImage from "../../assets/artist_placeholder.png";
import engberthImage from "../../assets/englberth.webp";
import hartovaImage from "../../assets/hartova.jpg";
import bornImage from "../../assets/adam_born.webp";

export const getStaticPaths = getStaticLangPaths;

type TArtistMedia = Record<
	string,
		{
			imageSrc?: string;
			imagePositionY?: string | number;
			links?: {
				website?: string;
				facebook?: string;
				instagram?: string;
				youtube?: string;
			};
		}
>;

const { lang } = Astro.params;
const { t } = getI18n(lang);

const artistMedia: TArtistMedia = {
	"Robert Hugo": {
		imageSrc: robertHugoImage.src,
		links: {
			website: "https://www.roberthugo.com/",
		}
	},
	"Viktoria Engelbert": {
		imageSrc: engberthImage.src,
		imagePositionY: 30,
		links: {
			website: "https://vikiviolin.com/",
			instagram: "https://www.instagram.com/viktoria.violin",
		}
	},
	"Eva Hartová": {
		imageSrc: hartovaImage.src,
		links: {
			website: "https://www.hartova.com/",

		}
	},
	"Marie Šimůnková": {
		links: {
			website: "https://mariesimunkova.cz/",
			facebook: "https://www.facebook.com/maruska.simunkova",
			instagram: "https://www.instagram.com/marie_simunkova_soprano/",
		}
	},
	"Adam Born": {
		imageSrc: bornImage.src,
		imagePositionY: 0,
		links: {
			website: "https://www.adamborn.cz/",

		}
	}
};

const artists = t.artistsPage.artists.map((artist) => ({
	...artist,
	imageSrc: artistMedia[artist.name]?.imageSrc ?? ensembleImage.src,
	imagePositionY: artistMedia[artist.name]?.imagePositionY,
	links: artistMedia[artist.name]?.links,
}));
---

<Layout lang={lang} title={t.artistsPage.title}>
	<PageHeader image={artistsHeroImage} title={t.artistsPage.title} subtitle={t.artistsPage.lead} imagePosition="center 35%" />

	<section class="bg-bg-primary py-16 lg:py-24">
		<div class="container">
			<div class="mx-auto max-w-3xl">
				{t.artistsPage.paragraphs.map((paragraph) => (
					<p class="mt-6 font-body text-base leading-relaxed text-text-secondary lg:text-lg">
						{paragraph}
					</p>
				))}
			</div>

			<div class="mx-auto mt-14 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{artists.map((artist) => (
					<ArtistMedallion
						name={artist.name}
						role={artist.role}
						bio={artist.bio}
						imageSrc={artist.imageSrc}
						imagePositionY={artist.imagePositionY}
						links={artist.links}
					/>
				))}
			</div>
		</div>
	</section>
</Layout>
