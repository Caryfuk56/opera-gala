---
import { getEntry } from "astro:content";
import { marked } from "marked";
import { getI18n, getStaticLangPaths, getPath } from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import Section from "../../components/ui/Section.astro";
import InlineMiniGallery from "../../components/gallery/InlineMiniGallery";

export const getStaticPaths = getStaticLangPaths;

const { lang } = Astro.params;
const { t } = getI18n(lang);

// Get content from collection
const pageEntry = await getEntry("pages", `${lang}/about`);

if (!pageEntry) {
	throw new Error(`Could not find content for page: ${lang}/about`);
}

const { title, description, sections = [] } = pageEntry.data;

// Process sections markdown content
type Section = {
	title?: string;
	content: string;
	image?: {
		src: string;
	};
	imageAlt?: string;
	imageCaption?: string;
	variant: "plain" | "image-left" | "image-right";
	background: "light" | "dark" | "parallax";
};

const processedSections = await Promise.all(
	sections.map(async (section: Section) => ({
		...section,
		htmlContent: await marked.parse(section.content),
	}))
);
---

<Layout lang={lang} title={title} description={description}>
	<PageHeader
		image={sections[0]?.image || { src: "" }}
		title={title}
		subtitle={description}
		imagePosition="center 62%"
		ctaPrimary={{
			label: t.aboutPage.concertsProgram, // "Upcoming concert" / "Nejbližší koncert"
			href: getPath(lang, "concert"),
		}}
	/>

	{
		processedSections.map((section, index) => (
			<>
				<Section
					variant={section.variant}
					background={section.background}
					image={
						section.image
							? {
									src: section.image.src,
									alt: section.imageAlt || "",
									caption: section.imageCaption,
								}
							: undefined
					}
					parallaxStrength={0.4}
				>
					{section.title && (
						<h2 class="mb-6 font-heading text-3xl font-bold lg:text-4xl">
							{section.title}
						</h2>
					)}
					<div
						class="prose prose-lg max-w-none text-current prose-headings:font-heading prose-headings:font-bold prose-p:font-body prose-p:leading-relaxed prose-strong:font-bold prose-strong:text-current"
						set:html={section.htmlContent}
					/>
				</Section>

				{/* Insert Gallery after the second section (Authentic Sound) */}
				{index === 1 && (
					<section class="bg-bg-primary py-8 lg:py-12 overflow-hidden">
						<div class="container">
							<InlineMiniGallery
								client:visible
								tag="concert:2026-02-12-příprava"
								limit={10}
								title={t.gallery.title}
								messages={{
									loading: t.inlineGallery.loading,
									error: t.inlineGallery.error,
									empty: t.inlineGallery.empty,
									more: t.inlineGallery.more,
								}}
							/>
						</div>
					</section>
				)}
			</>
		))
	}
</Layout>
