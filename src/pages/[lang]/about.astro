---
import { getI18n, getStaticLangPaths } from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import aboutHeroImage from "../../assets/o_projektu.png"

export const getStaticPaths = getStaticLangPaths;

const { lang } = Astro.params;
const { t } = getI18n(lang);
---

<Layout lang={lang} title={t.aboutPage.title}>
	<PageHeader 
		image={aboutHeroImage} 
		title={t.aboutPage.title}
		subtitle={t.aboutPage.lead}
		imagePosition="center 20%"
	/>

	<section class="bg-bg-primary py-16 lg:py-24">
		<div class="container">
			<div class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-12 lg:gap-14">
				<div class="lg:col-span-7">
					{t.aboutPage.paragraphs.map((paragraph) => (
						<p class="mt-6 font-body text-base leading-relaxed text-text-secondary lg:text-lg">
							{paragraph}
						</p>
					))}
				</div>

				<aside class="lg:col-span-5">
					<div class="space-y-4">
						<div class="aspect-[4/3] overflow-hidden rounded-lg bg-bg-secondary/50">
							<img src={aboutHeroImage.src} alt="" role="presentation" class="h-full w-full object-cover" loading="lazy" decoding="async" />
						</div>
						<div class="grid grid-cols-2 gap-4">
							<div class="aspect-square overflow-hidden rounded-lg bg-bg-secondary/40"></div>
							<div class="aspect-square overflow-hidden rounded-lg bg-bg-secondary/30"></div>
						</div>
					</div>
				</aside>
			</div>
		</div>
	</section>
</Layout>
