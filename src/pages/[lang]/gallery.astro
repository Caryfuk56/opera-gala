---
import { getI18n, getStaticLangPaths } from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import GalleryPage from "../../components/gallery/GalleryPage";
import galleryHeroImage from "../../assets/titulni_picture.jpg";

export const getStaticPaths = getStaticLangPaths;

const { lang } = Astro.params;
const { t } = getI18n(lang);
---

<Layout lang={lang} title={t.galleryPage.title}>
	<PageHeader image={galleryHeroImage} title={t.galleryPage.title} subtitle={t.galleryPage.lead} imagePosition="center 35%" />
	<GalleryPage
		title={t.galleryPage.title}
		emptyMessage={t.galleryPage.empty}
		loadingMessage={t.galleryPage.loading}
		errorMessage={t.galleryPage.error}
		client:load
	/>
</Layout>
