---
import { getI18n, getStaticLangPaths } from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import ConcertPanel from "../../components/sections/ConcertPanel.astro";
import { fetchUpcomingEvents, parseEventDescription, getEventIsoDate, formatDate, type CalendarEvent } from "../../utils/googleCalendar";

export const getStaticPaths = getStaticLangPaths;

const { lang } = Astro.params;
const { t } = getI18n(lang);

const apiKey = import.meta.env.GOOGLE_CALENDAR_API;
const calendarId = import.meta.env.GOOGLE_CALENDAR_ID;

let events: CalendarEvent[] = [];
let loadError: string | null = null;

if (!apiKey || !calendarId) {
	if (import.meta.env.DEV) {
		const missing = [
			!apiKey && "GOOGLE_CALENDAR_API",
			!calendarId && "GOOGLE_CALENDAR_ID",
		].filter(Boolean).join(", ");
		console.warn(`Google Calendar events were not loaded. Missing environment variables: ${missing}`);
	}
	loadError = t.concerts.error;
} else {
	try {
		events = await fetchUpcomingEvents({ calendarId, apiKey, maxResults: 20 });
	} catch (err) {
		loadError = t.concerts.error;
	}
}
---

<Layout lang={lang} title={t.concerts.title}>
	<section class="bg-bg-primary py-16 lg:py-24">
		<div class="container">
			<h1 class="font-heading text-3xl font-bold text-text-primary sm:text-4xl lg:text-5xl">
				{t.concerts.title}
			</h1>

			{loadError ? (
				<p class="mt-8 font-body text-base text-text-secondary">{loadError}</p>
			) : events.length === 0 ? (
				<p class="mt-8 font-body text-base text-text-secondary">{t.concerts.empty}</p>
			) : (
				<div class="mt-12 space-y-6">
					{events.map((event) => {
						const isoDate = getEventIsoDate(event);
						const dateObj = isoDate ? formatDate(isoDate, lang, "full") : { day: "", month: "", year: "" };
						const parsed = parseEventDescription(event.description);

						return (
							<ConcertPanel
								id={event.id}
								title={event.summary ?? ""}
								subtitle={parsed.subtitle}
								date={dateObj}
								ticketUrl={parsed.ticket}
								lang={lang}
								dateVariant="full"
							/>
						);
					})}
				</div>
			)}
		</div>
	</section>
</Layout>
