---
import { getI18n } from "../../../i18n";
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/ui/PageHeader.astro";
import CtaButton from "../../../components/ui/CtaButton.astro";
import { fetchEventById, parseEventDescription, getEventIsoDate, formatDate, sanitizeProgramHtml } from "../../../utils/googleCalendar";
import aboutHeroImage from "../../../assets/o_projektu.png"; // reusing hero image for concert detail for now

const lang = Astro.params.lang ?? "cs";
const { id } = Astro.params as Record<string, string | undefined>;
const { t } = getI18n(lang);

const apiKey = import.meta.env.GOOGLE_CALENDAR_API;
const calendarId = import.meta.env.GOOGLE_CALENDAR_ID;

if (!apiKey || !calendarId || !id) {
	if (import.meta.env.DEV) {
		const missing = [
			!apiKey && "GOOGLE_CALENDAR_API",
			!calendarId && "GOOGLE_CALENDAR_ID",
			!id && "concert id",
		].filter(Boolean).join(", ");
		console.warn(`Google Calendar event detail was not loaded. Missing: ${missing}`);
	}
	throw new Response(null, { status: 404 });
}

let event;
try {
	event = await fetchEventById({ calendarId, apiKey, id });
} catch (error) {
	console.error(`Error fetching calendar event ${id}:`, error);
	throw new Response(t.concerts.error, { status: 503 });
}

if (!event) {
	throw new Response(null, { status: 404 });
}

const isoDate = getEventIsoDate(event);
const dateLabel = isoDate ? formatDate(isoDate, lang, "full").full : "";
const parsed = parseEventDescription(event.description);
const cleanProgram = parsed.program ? sanitizeProgramHtml(parsed.program.replace(/\n/g, '<br />')) : null;
const pageDescription = parsed.subtitle || `${dateLabel}. ${t.seo.concertDescription}`;
const eventJsonLd = {
	"@context": "https://schema.org",
	"@type": "MusicEvent",
	name: event.summary ?? t.concerts.title,
	description: pageDescription,
	startDate: isoDate,
	location: event.location
		? {
				"@type": "Place",
				name: event.location,
			}
		: undefined,
	url: Astro.url.toString(),
	offers: parsed.ticket
		? {
				"@type": "Offer",
				url: parsed.ticket,
				availability: "https://schema.org/InStock",
			}
		: undefined,
	organizer: {
		"@type": "Organization",
		name: "Opera Gala Valtice",
	},
};
---

<Layout lang={lang} title={event.summary ?? t.concerts.title} description={pageDescription} type="article">
	<script is:inline type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
	<PageHeader 
		image={aboutHeroImage} 
		title={event.summary ?? t.concerts.title}
		subtitle={parsed.subtitle}
		imagePosition="center 20%"
	/>

	<section class="bg-bg-primary py-16 lg:py-24">
		<div class="container mx-auto max-w-4xl">
			<div class="mb-10 text-center">
				<p class="font-heading text-xl text-accent lg:text-2xl font-bold">{dateLabel}</p>
			</div>

			{cleanProgram && (
				<div class="mt-10 rounded-lg border border-text-secondary/10 bg-bg-secondary/30 p-6">
					<h2 class="font-heading text-lg font-semibold text-text-primary">Program</h2>
					<div class="mt-4 prose prose-invert max-w-none font-body text-sm leading-relaxed text-text-secondary" set:html={cleanProgram} />
				</div>
			)}

			{parsed.ticket && (
				<div class="mt-12 text-center">
					<CtaButton href={parsed.ticket} variant="highlighted">
						{t.concerts.tickets}
					</CtaButton>
				</div>
			)}
		</div>
	</section>
</Layout>
